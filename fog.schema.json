{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["scripts"],
  "properties": {
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "service": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "cmd"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "cmd": { "type": "string" },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Names of services this service depends on"
                },
                "shutdown_cmd": {
                  "type": "string",
                  "description": "Shell command to run when fog shuts down (e.g. docker compose down)"
                },
                "reuse": {
                  "type": "boolean",
                  "default": false,
                  "description": "When another instance of the same project+script starts, this service is reused instead of torn down: its shutdown_cmd is skipped, a live process is handed over, and starting it is skipped if it is already up (verified via health_check)."
                },
                "health_check": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["kind", "target"],
                      "properties": {
                        "kind": { "type": "string", "enum": ["tcp", "http", "docker"] },
                        "target": { "type": "string" },
                        "compose_file": {
                          "type": "string",
                          "description": "Compose file used by the `docker` health kind, relative to the service path (default: docker-compose.yml)"
                        },
                        "interval_ms": { "type": "integer", "minimum": 100, "default": 5000 },
                        "timeout_ms": { "type": "integer", "minimum": 100, "default": 2000 }
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["kind", "target"],
                        "properties": {
                          "kind": { "type": "string", "enum": ["tcp", "http", "docker"] },
                          "target": { "type": "string" },
                          "compose_file": {
                            "type": "string",
                            "description": "Compose file used by the `docker` health kind, relative to the service path (default: docker-compose.yml)"
                          },
                          "interval_ms": { "type": "integer", "minimum": 100, "default": 5000 },
                          "timeout_ms": { "type": "integer", "minimum": 100, "default": 2000 }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "proxy": {
            "type": "object",
            "required": ["port", "routes"],
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "host": {
                "type": "string"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "upstream"],
                  "properties": {
                    "path": { "type": "string" },
                    "host": { "type": "string" },
                    "upstream": { "type": "string" },
                    "ws": { "type": "boolean" }
                  }
                }
              },
              "tls_cert": { "type": "string" },
              "tls_key": { "type": "string" }
            }
          }
        }
      }
    },
    "max_scrollback": {
      "type": "integer",
      "minimum": 100,
      "default": 2000
    },
    "dnsmasq": {
      "type": "object",
      "description": "Wildcard DNS routes set up through dnsmasq automatically on startup. Each domain is mapped so any *.<domain> hostname resolves to the configured address.",
      "properties": {
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domains to wildcard-map, e.g. ['red-fox'] makes main.red-fox resolve to 127.0.0.1"
        },
        "address": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Address that *.<domain> resolves to"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 53,
          "description": "Port dnsmasq listens on (default: 53). On macOS the daemon runs as a root LaunchDaemon so it can bind this privileged port; the /etc/resolver zone file uses a plain nameserver line."
        }
      },
      "required": ["domains"]
    },
    "router": {
      "type": "object",
      "description": "Central reverse proxy (Traefik) set up automatically on startup. A single host-level instance shared across every project and branch, so apps do not run their own (which would collide on the published port). Apps opt in by attaching to the shared network and declaring Traefik labels.",
      "properties": {
        "image": {
          "type": "string",
          "default": "traefik:v3",
          "description": "Traefik image to run"
        },
        "hostname": {
          "type": "string",
          "description": "Hostname for the Traefik dashboard (e.g. router.red-fox). Must be covered by dnsmasq.domains."
        },
        "dashboard_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8080,
          "description": "Host port for the Traefik dashboard"
        },
        "shared_network": {
          "type": "string",
          "default": "fog-router",
          "description": "Name of the external Docker network shared with app services"
        }
      }
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "min_width": { "type": "integer", "minimum": 8, "maximum": 50 },
        "max_width": { "type": "integer", "minimum": 8, "maximum": 50 }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "proxy": { "type": "string" },
        "terminal": { "type": "string" },
        "stopped": { "type": "string" },
        "highlight": { "type": "string" },
        "status_200": { "type": "string" },
        "status_300": { "type": "string" },
        "status_400": { "type": "string" },
        "status_500": { "type": "string" },
        "scrollbar": { "type": "string" }
      }
    }
  }
}
