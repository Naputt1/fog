{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "service": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "cmd"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "cmd": { "type": "string" }
        }
      }
    },
    "proxy": {
      "type": "object",
      "required": ["port", "routes"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "upstream"],
            "properties": {
              "path": { "type": "string" },
              "upstream": { "type": "string" },
              "ws": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
    "max_scrollback": {
      "type": "integer",
      "minimum": 100,
      "default": 2000
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "min_width": { "type": "integer", "minimum": 8, "maximum": 50 },
        "max_width": { "type": "integer", "minimum": 8, "maximum": 50 }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "proxy": { "type": "string" },
        "terminal": { "type": "string" },
        "stopped": { "type": "string" },
        "highlight": { "type": "string" },
        "status_200": { "type": "string" },
        "status_300": { "type": "string" },
        "status_400": { "type": "string" },
        "status_500": { "type": "string" }
      }
    }
}
